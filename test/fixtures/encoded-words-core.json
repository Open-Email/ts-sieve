  "normalization": "Existing Sieve CR/LF unfolding before Core decodeHeaderShim; goUtf8ToString converts the final bytes.",
  "cases": [
    {
      "name": "Q text containing a question mark",
      "input": "=?utf-8?q?vi=61gra?x?=",
      "expected": "viagra?x"
    },
    {
      "name": "bad Q escape shares its closing equals with the next word",
      "input": "=?utf-8?q?a=zz?=?utf-8?q?vi=61gra?=",
      "expected": "=?utf-8?q?a=zz?viagra"
    },
    {
      "name": "Q control byte shares its closing equals with the next word",
      "input": "=?utf-8?q?a\u0001?=?utf-8?q?vi=61gra?=",
      "expected": "=?utf-8?q?a\u0001?viagra"
    },
    {
      "name": "unpadded base64 shares its closing equals with the next word",
      "input": "=?utf-8?b?YQ?=?utf-8?q?vi=61gra?=",
      "expected": "=?utf-8?b?YQ?viagra"
    },
    {
      "name": "unsupported charset",
      "input": "=?windows-1252?q?caf=E9?= x",
      "expected": "=?windows-1252?q?caf=E9?= x"
    },
    {
      "name": "unframable marker stops the remaining decode",
